{
  "name": "schale-library",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev:server": "pnpm --dir server dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "lint": "pnpm --dir frontend lint",
    "test:server": "pnpm --dir server test",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "next>postcss": "8.5.10"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}

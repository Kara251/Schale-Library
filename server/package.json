{
  "name": "schale-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply schale_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply schale_db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20260702.1",
    "drizzle-orm": "^0.38.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.103.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext on Cloudflare Workers (W6 迁移准备)
  // 构建产物: opennextjs-cloudflare build -> .open-next/
  "name": "schale-library-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}

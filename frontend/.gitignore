# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# 生产构建期的公开变量（NEXT_PUBLIC_*，必须在构建时就位才能内联进产物）。
# 只放非机密值 —— 密钥一律 wrangler secret put。
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode
.idea
*.sublime-workspace


.vercel

# opennext / cloudflare workers
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# 内容 API 地址（server/ 的 Hono Worker）。生产值见 .env.production
NEXT_PUBLIC_API_URL=http://localhost:8787

# 前端站点地址，用于登录回跳、同源后台接口、metadataBase/sitemap/robots 及 OG 图片绝对地址（lib/config.ts 的 SITE_URL）
# middleware 的 canonicalHostRedirect 也以此为准：非 www 的 apex 访问会 308 到这里的主机名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前端服务端调用 Worker 内部限流接口的共享令牌；必须和 server/ 的同名 secret 一致
# 生产环境经 wrangler secret put 设置，不进配置文件
PANEL_INTERNAL_TOKEN=change-me

# 前端请求内容 API 的默认超时，单位 ms
API_TIMEOUT_MS=10000

# 后台面板允许的角色（逗号分隔）
# 生产环境缺省拒绝全部登录（fail-closed），必须显式列出
ADMIN_PANEL_ALLOWED_ROLES=maintainer,admin

# 可选：生产环境后台面板额外信任的来源（逗号分隔 origin 列表，用于跨域写操作校验）
ADMIN_PANEL_TRUSTED_ORIGINS=

# 可选：分析与统计
# CF Web Analytics 的 beacon token（Dashboard → Analytics & Logs → Web Analytics 签发）
NEXT_PUBLIC_CF_BEACON_TOKEN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

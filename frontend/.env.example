# Strapi 后端 API 地址
NEXT_PUBLIC_API_URL=http://localhost:8083

# 前端站点地址，用于登录回跳、同源后台接口、metadataBase/sitemap/robots 及 OG 图片绝对地址（lib/config.ts 的 SITE_URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前端服务端调用 Strapi 内部接口的共享令牌；生产环境必须和 backend 一致
PANEL_INTERNAL_TOKEN=change-me

# 前端请求 Strapi 的默认超时，单位 ms
API_TIMEOUT_MS=10000

# 生产环境后台面板允许的 users-permissions 角色 type/name
ADMIN_PANEL_ALLOWED_ROLES=maintainer,admin

# 可选：后台自检显示 RSSHub 连通性时使用
RSSHUB_URL=http://localhost:1200

# 可选：Strapi 管理后台入口地址；设置后后台面板直接跳转该地址（research-curator 页面）
STRAPI_ADMIN_URL=

# 可选：同上，客户端可读版本；STRAPI_ADMIN_URL 未设置时使用
NEXT_PUBLIC_STRAPI_ADMIN_URL=

# 可选：生产环境后台面板额外信任的来源（逗号分隔 origin 列表，用于跨域写操作校验）
ADMIN_PANEL_TRUSTED_ORIGINS=
